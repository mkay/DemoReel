  The icon's ground: the slate gradient the mark is drawn on, slate-400 into slate-500 along the
  tile's diagonal. It is a full-bleed rectangle rather than the disc the artwork was drawn as, so
  that every launcher mask — circle, squircle, rounded square — is filled to its own edge and the
  gradient the mark sits on is the same one whichever shape the device cuts.

  The ramp is pinned to where it ran in the artwork (the disc's inscribed diagonal, mapped onto this
  canvas), so the mark meets the same colours it was drawn against; the corners outside that run
  clamp to the end colours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27.42"
                android:startY="27.75"
                android:endX="80.58"
                android:endY="79.79">
                <item android:offset="0" android:color="#90A1B9" />
                <item android:offset="1" android:color="#62748E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
