    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_version_copied">Version kopiert</string>
    <string name="about_section_about">Über</string>
    <string name="about_body">Ein Player und Tag-Editor für deine eigenen Demomixe. Er liest einen
        Ordner, zeigt was darin liegt, spielt es ab, und schreibt Interpret, Cover und den Rest in
        die Dateien selbst.</string>
    <string name="about_section_privacy">Datenschutz</string>
    <string name="about_privacy_body">Demo Reel fordert überhaupt keine Berechtigungen an. Kein
        Zugriff auf die Medienbibliothek des Geräts, kein Netzwerkzugriff, keine Analyse. Der Ordner,
        den du freigibst, ist alles, was die App sehen kann.</string>
    <string name="about_section_website">Quelltext</string>
    <string name="about_website_body">Die ganze App, freie Software.</string>
    <string name="about_section_bugs">Fehler und Wünsche</string>
    <string name="about_bugs_body">Etwas kaputt, oder fehlt dir etwas? Der Issue-Tracker ist der
        richtige Ort.</string>
    <string name="about_section_license">Lizenz</string>
    <string name="about_license">Veröffentlicht unter der GNU General Public License, Version 3. Du
        darfst sie nutzen, studieren, weitergeben und verändern — solange alles, was du weitergibst,
        dieselben Freiheiten mitbringt.</string>
    <string name="about_lame">MP3-Dateien werden mit LAME geschrieben, von den
        LAME-Entwicklern, unverändert genutzt unter der GNU Lesser General Public License,
        Version 2.1. Der Quelltext liegt im Repository dieser App.</string>

