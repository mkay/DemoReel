    <string name="about_section_about">About</string>
    <string name="about_body">A player and tagger for your own demo mixes. It reads one folder, shows
        what is in it, plays it back, and lets you put the artist, the artwork and the rest onto the
        files themselves.</string>
    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_body">Demo Reel asks for no permissions at all. It has no access to
        the device\'s media library, no network access, and no analytics. The folder you grant is
        everything it can see.</string>
    <string name="about_section_website">Source</string>
    <string name="about_website_body">The whole app, free software.</string>
    <string name="about_section_bugs">Bugs and suggestions</string>
    <string name="about_bugs_body">Found something broken, or want something it does not do? The
        issue tracker is the place.</string>
