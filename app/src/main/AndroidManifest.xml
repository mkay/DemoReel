<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No permission that widens what the app can reach, and that is its whole premise. Demo Reel
      reads one folder the user hands it through the Storage Access Framework and nothing else — no
      READ_MEDIA_AUDIO, so the ringtones, the podcasts and the rest of the device's music cannot
      leak into the library even by accident. The grant is the boundary; there is no wider one to
      fall back on.

      That is the test anything declared here has to pass, and it is narrower than "as few as
      possible": a permission to act on what the grant already reaches is fair, a permission to
      reach further is not. Playing in the background needs the first kind and none of the second.
    -->

    <!--
      Background playback, and nothing beyond it. The service is what keeps a mix alive once the UI
      is gone, the notification is how it is controlled from outside the app, and the wake lock is
      what stops the CPU sleeping under a mix played with the screen off. Not one of them reads a
      byte the folder grant did not already reach.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      ExoPlayer's own manifest asks for ACCESS_NETWORK_STATE, for adapting a stream's bitrate to the
      connection. This app has no streams and no network: every mix is a local document under the
      folder grant. Taken back out, because a permission arriving as a transitive gift is still a
      permission on the install screen, and this one reaches somewhere the app has no business.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DemoReel">

        <!--
            Not a service that ever runs — it is disabled, and exists only to carry the meta-data
            below. That flag is how AppCompat is told to persist the language chosen in Settings.

            Without it the choice survives only until the process dies. Android 13 and up hides
            that: there the framework stores the per-app language itself, so the bug is invisible
            on a modern device and shows up only on 8 to 12 — which is the entire span AppCompat
            was added for.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            Serves exactly one file: the cover image that "Copy image" puts on the clipboard, so
            that whatever pastes it has something readable to point at. A clipboard entry is a uri,
            and a uri into an app's own cache is unreadable to anyone else without a provider.

            Not exported, and it grants nothing by itself — the clipboard hands out a read
            permission scoped to the one uri, for as long as that clip is on it. See
            [de.singular.player.storage.ImageClipboard].
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Tells Android Auto this app projects a media library. Without it the service is
            reachable but the app never appears in the car at all.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Exported, which sounds worse than it is: a media session has to be reachable by the
            system's own media controls, by a Bluetooth headset, and later by a car head unit, and
            that is all this exposes. It serves a session, not the folder behind it.
        -->
        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            singleTop, so an intent for an app that is already open reaches the running Activity's
            onNewIntent. With the default mode, an intent matching the one that started the task —
            a second "play … on Demo Reel", say, extras aside — only brings the task to the front,
            and the request is dropped without the app ever seeing it.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:exported="true"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Receiving a mix from elsewhere — a share, or an "open with". The one thing in the
                app that reaches outside the granted folder, and it does not widen that grant: the
                sending app attaches a read permission to the single uri it hands over, for as long
                as this task lives. Nothing is copied and nothing is indexed.

                Both actions, because senders differ: a file manager sends VIEW, a share sheet SEND.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!--
                "Play … on Demo Reel", said to the assistant. The words go to the playback service
                as a spoken request, which answers it with the library's own search; see
                [de.singular.player.media.Library.playbackForSearch]. In the car the same request
                reaches the service directly, and this filter is also what tells Android Auto the
                app takes voice requests at all.
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
